# Production Dockerfile for Railway/Render
# This builds the frontend service which exposes port 3000

FROM node:18-alpine AS frontend-builder

WORKDIR /app
COPY nodejs_frontend/package*.json ./
RUN npm ci --only=production

FROM node:18-alpine

WORKDIR /app
COPY --from=frontend-builder /app/node_modules ./node_modules
COPY nodejs_frontend/ ./

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "server.js"]

